# Neon PostgreSQL in production. Vercel's Neon integration normally injects
# DATABASE_URL; use this SQLAlchemy-form URL when supplying it yourself.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/DATABASE?sslmode=require
# If Neon was connected with `--prefix NEON_`, this alternative is also read:
# NEON_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/DATABASE?sslmode=require
# A long random secret in hosted environments. Do not reuse the example.
AUTH_SECRET=replace-with-a-long-random-secret
# Required together for partner media uploads in Vercel Blob. BLOB_STORE_ID is
# the leading subdomain of the store's public URL; keep the token secret.
BLOB_STORE_ID=your-blob-store-id
BLOB_READ_WRITE_TOKEN=
