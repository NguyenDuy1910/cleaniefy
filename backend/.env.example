# PostgreSQL in production; SQLite is used automatically for local demo mode.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
# A long random secret in hosted environments. Do not reuse the example.
AUTH_SECRET=replace-with-a-long-random-secret
# Required only for partner media uploads in Vercel Blob.
BLOB_READ_WRITE_TOKEN=
