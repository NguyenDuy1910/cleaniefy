# Neon PostgreSQL. Connect Neon to the Vercel project, or set a local pooled URL.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/DATABASE?sslmode=require
# Required for signed httpOnly partner sessions in production.
AUTH_SECRET=replace-with-a-long-random-secret
# Connected Vercel Blob store. Keep the read/write token server-only.
BLOB_STORE_ID=store_your_blob_store_id
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
